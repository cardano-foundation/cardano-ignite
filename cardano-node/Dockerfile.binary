ARG BASE_IMAGE=cardano-ignite-base
ARG TESTNET_BUILDER_IMAGE=scratch

FROM ${BASE_IMAGE} AS build

ARG CARDANO_NODE_VERSION="11.0.1"

ENV TZ="UTC"
RUN ln -snf /usr/share/zoneinfo/${TZ} /etc/localtime && \
    echo ${TZ} > /etc/timezone

RUN apt update && \
    apt install -y --no-install-recommends \
        git && \
    rm -rf /var/lib/apt/lists/*

# cardano-node

RUN install --directory --owner=root --group=root --mode=0755 /usr/local/src/cardano-node

RUN curl --proto '=https' --tlsv1.3 \
        --location https://github.com/IntersectMBO/cardano-node/releases/download/${CARDANO_NODE_VERSION}/cardano-node-${CARDANO_NODE_VERSION}-linux-amd64.tar.gz \
        --output /usr/local/src/cardano-node/cardano-node-${CARDANO_NODE_VERSION}-linux-amd64.tar.gz
RUN curl --proto '=https' --tlsv1.3 \
        --location https://github.com/IntersectMBO/cardano-node/releases/download/${CARDANO_NODE_VERSION}/cardano-node-${CARDANO_NODE_VERSION}-sha256sums.txt \
        --output /usr/local/src/cardano-node/cardano-node-${CARDANO_NODE_VERSION}-sha256sums.txt

WORKDIR /usr/local/src/cardano-node
RUN sha256sum --ignore-missing --check cardano-node-${CARDANO_NODE_VERSION}-sha256sums.txt

RUN install --directory --owner=root --group=root --mode=0755 /usr/local/src/cardano-node/${CARDANO_NODE_VERSION}
RUN tar --extract --gzip --file=/usr/local/src/cardano-node/cardano-node-${CARDANO_NODE_VERSION}-linux-amd64.tar.gz --directory=/usr/local/src/cardano-node/${CARDANO_NODE_VERSION}
RUN chmod 0755 /usr/local/src/cardano-node/${CARDANO_NODE_VERSION}/bin/cardano-cli \
        /usr/local/src/cardano-node/${CARDANO_NODE_VERSION}/bin/cardano-node \
        /usr/local/src/cardano-node/${CARDANO_NODE_VERSION}/bin/tx-generator
RUN ln -snf /usr/local/src/cardano-node/${CARDANO_NODE_VERSION}/bin/cardano-cli /usr/local/bin/cardano-cli && \
    ln -snf /usr/local/src/cardano-node/${CARDANO_NODE_VERSION}/bin/cardano-node /usr/local/bin/cardano-node && \
    ln -snf /usr/local/src/cardano-node/${CARDANO_NODE_VERSION}/bin/tx-generator /usr/local/bin/tx-generator

# The plutus fallback scripts are not part of the release archive.
# --fail: unlike the archive downloads (validated by tar/sha256sum), nothing
# checks this file, so make curl fail on HTTP errors instead of saving the
# error page as the script.
RUN curl --proto '=https' --tlsv1.3 --fail \
        --location https://raw.githubusercontent.com/IntersectMBO/cardano-node/${CARDANO_NODE_VERSION}/bench/tx-generator/scripts-fallback/Loop.plutus \
        --output /usr/local/src/cardano-node/Loop.plutus

#---------------------------------------------------------------------

FROM ${TESTNET_BUILDER_IMAGE} AS testnet_builder

#---------------------------------------------------------------------

FROM ${BASE_IMAGE} AS main

ENV CARDANO_NODE_SOCKET_PATH="/opt/cardano-node/data/db/node.socket"

ENV TZ="UTC"
RUN ln -snf /usr/share/zoneinfo/${TZ} /etc/localtime && \
    echo ${TZ} > /etc/timezone

RUN apt update && \
    apt install -y --no-install-recommends \
        doas \
        libsnappy1v5 \
        liburing2 \
        locales \
        postgresql-client && \
    rm -rf /var/lib/apt/lists/*

RUN sed -i 's/^# *en_US.UTF-8 UTF-8/en_US.UTF-8 UTF-8/' /etc/locale.gen && \
    locale-gen

ENV LANG=en_US.UTF-8 \
    LANGUAGE=en_US:en \
    LC_ALL=en_US.UTF-8

# cardano-cli

COPY --from=build --chown=root:root /usr/local/bin/cardano-cli /usr/local/bin/cardano-cli

# cardano-node

COPY --from=build --chown=root:root /usr/local/bin/cardano-node /usr/local/bin/cardano-node

# tx-generator

COPY --from=build --chown=root:root /usr/local/bin/tx-generator /usr/local/bin/tx-generator

# user and group

RUN groupadd --gid 10000 cardano && \
    useradd --comment 'cardano' --create-home --gid 10000 --password '!' --shell '/bin/bash' --uid 10000 cardano

# cardano-node

RUN install --directory --owner=root --group=root --mode=0755 /opt/cardano-node && \
    install --directory --owner=cardano --group=cardano --mode=0750 /opt/cardano-node/config && \
    install --directory --owner=cardano --group=cardano --mode=0750 /opt/cardano-node/data && \
    install --directory --owner=cardano --group=cardano --mode=0750 /opt/cardano-node/data/db && \
    install --directory --owner=cardano --group=cardano --mode=0750 /opt/cardano-node/log && \
    install --directory --owner=cardano --group=cardano --mode=0750 /opt/cardano-node/pools

COPY --from=testnet_builder --chown=cardano:cardano /tmp/testnet/pools /opt/cardano-node/pools
COPY --from=testnet_builder --chown=cardano:cardano /tmp/testnet/utxos /opt/cardano-node/utxos

RUN install --directory --owner=cardano --group=cardano --mode=0750 /opt/tx-generator/scripts-fallback

COPY --from=build --chown=cardano:cardano /usr/local/src/cardano-node/Loop.plutus /opt/tx-generator/scripts-fallback/Loop.plutus

# Permit cardano user to run commands 'ip' and 'tc' as root
RUN echo 'permit setenv { PATH=/bin:/sbin:/usr/bin:/usr/sbin:/usr/local/bin:/usr/local/sbin } :cardano' >> /etc/doas.conf
RUN echo 'permit nopass cardano as root cmd ip' >> /etc/doas.conf
RUN echo 'permit nopass cardano as root cmd tc' >> /etc/doas.conf

COPY cardano-node/scripts/*.sh /
COPY scripts/node_routes.sh /
RUN chmod 0755 /*.sh

COPY cardano-node/cmd.sh /
RUN chmod 0755 /cmd.sh

USER cardano

CMD ["/cmd.sh"]
