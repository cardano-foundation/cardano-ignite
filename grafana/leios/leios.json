        "tooltip": { "hideZeros": false, "mode": "multi", "sort": "none" }
      },
      "pluginVersion": "12.1.0",
      "targets": [
        {
          "editorMode": "code",
          "expr": "sum(rate(cardano_node_metrics_Forge_endorser_block_total_tx_count_counter[5m]))",
          "interval": "",
          "legendFormat": "endorser blocks (EB)",
          "range": true,
          "refId": "A"
        },
        {
          "editorMode": "code",
          "expr": "sum(rate(cardano_node_metrics_Forge_ranking_block_total_tx_count_counter[5m]))",
